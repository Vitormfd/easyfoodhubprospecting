# ============================================================
# Supabase (obrigatorio)
# Crie um projeto gratuito em https://supabase.com e copie os
# valores em Project Settings > API.
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: NUNCA expor no frontend. Usada só em server
# actions/route handlers para operações administrativas (ex.:
# gerenciar competitor_fingerprints).
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Anthropic (opcional, mas necessário para gerar mensagens com IA)
# https://console.anthropic.com
# ============================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ============================================================
# Google Places (opcional - fonte adicional de busca de
# estabelecimentos). Sem essa chave, o sistema usa só o
# OpenStreetMap (Overpass API), que é público e gratuito.
# https://developers.google.com/maps/documentation/places/web-service
# ============================================================
GOOGLE_PLACES_API_KEY=

# ============================================================
# Meta / Instagram Graph API (opcional - envio de mensagem via
# API oficial). Sem isso, a Fila de Prospecção usa o fluxo
# manual (copiar mensagem + abrir perfil).
# https://developers.facebook.com/docs/instagram-platform
# ============================================================
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
